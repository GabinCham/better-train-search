HEADLESS=false
SLOW_MO=30
MAX_RETRIES=4

# Proxies (séparés par des virgules)
PROXY_LIST=http://user:pass@ip1:port,http://user:pass@ip2:port

# 2Captcha (optionnel)
TWOCAPTCHA_API_KEY=

# Dossier des profils persistants
PROFILES_DIR=./profiles

# Discord : Salon → Paramètres → Intégrations → Webhooks → Nouveau webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Surveillance (python main.py --watch)
# Intervalle normal aléatoire : 10 à 20 minutes
WATCH_INTERVAL_MIN_SECONDS=600
WATCH_INTERVAL_MAX_SECONDS=1200
# Après un échec complet/challenge : 30 à 60 minutes
ERROR_BACKOFF_MIN_SECONDS=1800
ERROR_BACKOFF_MAX_SECONDS=3600
# Une seule alerte challenge toutes les 30 minutes maximum
CHALLENGE_ALERT_COOLDOWN_SECONDS=1800
SEEN_OFFERS_FILE=./seen_offers.json
OFFERS_FILE=./offers.json
DASHBOARD_FILE=./dashboard.json
# Serveur local / public
LINK_SERVER_HOST=127.0.0.1
LINK_SERVER_PORT=8765
PUBLIC_BASE_URL=
OPEN_OFFERS_IN_CLIENT=false

# Fichier des trajets (départ + destination + date)
INSTRUCTIONS_FILE=./instructions.yaml